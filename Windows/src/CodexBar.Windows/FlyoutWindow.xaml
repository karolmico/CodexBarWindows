<Window x:Class="CodexBar.Windows.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexBar"
        Width="380"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#356A9A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#FBFBFD"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CodexBar" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FooterText}"
                               Margin="10,1,0,0"
                               FontSize="11"
                               Foreground="#6B6B70"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="↻"
                        Style="{StaticResource IconButton}"
                        Click="OnRefresh"
                        ToolTip="Refresh now" />
                <Button Grid.Column="2"
                        Content="⚙"
                        Style="{StaticResource IconButton}"
                        Click="OnSettings"
                        ToolTip="Settings" />
            </Grid>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="CopyDiagnosticsButton"
                        DockPanel.Dock="Right"
                        Content="Copy diagnostics"
                        Style="{StaticResource LinkButton}"
                        Click="OnCopyDiagnostics"
                        ToolTip="Copy a redacted diagnostics bundle" />
                <TextBlock x:Name="DiagnosticsStatus"
                           Margin="0,0,8,0"
                           MaxWidth="230"
                           FontSize="11"
                           Foreground="#6B6B70"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </DockPanel>

            <ScrollViewer Margin="0,10,0,0"
                          MaxHeight="620"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProviderList" ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Background="White"
                                    BorderBrush="#1A000000"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Status}"
                                                   DockPanel.Dock="Right"
                                                   FontSize="11"
                                                   Foreground="#9A6700"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11"
                                               Foreground="#6B6B70"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" />
                                                        <TextBlock Text="{Binding UsageText}"
                                                                   DockPanel.Dock="Right"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </DockPanel>
                                                    <ProgressBar Height="6"
                                                                 Margin="0,3,0,2"
                                                                 Maximum="100"
                                                                 Value="{Binding UsedPercent, Mode=OneWay}" />
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding ResetText}"
                                                                   FontSize="10"
                                                                   Foreground="#6B6B70" />
                                                        <TextBlock Text="exhausted"
                                                                   DockPanel.Dock="Right"
                                                                   FontSize="10"
                                                                   Foreground="#B42318"
                                                                   Visibility="{Binding IsExhausted, Converter={StaticResource BooleanToVisibility}}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
