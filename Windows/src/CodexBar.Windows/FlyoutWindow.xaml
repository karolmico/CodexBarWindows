<Window x:Class="CodexBar.Windows.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.Windows"
        Title="CodexBar"
        Width="460"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:HexBrushConverter x:Key="HexBrush" />
        <local:IconGeometryConverter x:Key="IconGeometry" />
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:HasValueToVisibilityConverter x:Key="HasValue" />
        <local:EmptyToVisibilityConverter x:Key="Empty" />

        <!-- Tab in the provider switcher: mark over name over a health dot, pill when selected. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7A7A85" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1F2937" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One menu row: glyph, label, hover wash. Used for provider and app actions. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0A000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0A000000" />
                                <Setter Property="Foreground" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat 6px capsule track; the indicator inherits the provider accent through Foreground. -->
        <Style x:Key="PillProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#14000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin overlay scrollbar: no arrows, no chrome, just a rounded thumb. -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#26000000" CornerRadius="4" Margin="2,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Detail pane for the selected provider. -->
        <DataTemplate x:Key="ProviderDetail">
            <StackPanel Margin="16,12,16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="#9CA3AF" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Margin="8,2,0,0"
                            Padding="7,3"
                            CornerRadius="6"
                            Background="#0C000000"
                            Visibility="{Binding Plan, Converter={StaticResource HasValue}}">
                        <TextBlock Text="{Binding Plan}" FontSize="10.5" Foreground="#4B5563" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding Status}"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="#B45309"
                           Visibility="{Binding Status, Converter={StaticResource HasValue}}" />

                <ItemsControl ItemsSource="{Binding Windows}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <Border DockPanel.Dock="Right"
                                            Margin="6,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="5"
                                            Background="#14B42318"
                                            Visibility="{Binding IsExhausted, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="exhausted" FontSize="10" Foreground="#B42318" />
                                    </Border>
                                </DockPanel>

                                <ProgressBar Style="{StaticResource PillProgress}"
                                             Margin="0,7,0,0"
                                             Value="{Binding UsedPercent, Mode=OneWay}"
                                             Foreground="{Binding Accent, Converter={StaticResource HexBrush}}" />

                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding UsageText}" FontSize="11" Foreground="#4B5563" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ResetText}"
                                               FontSize="11"
                                               Foreground="#9CA3AF" />
                                </DockPanel>

                                <TextBlock Text="{Binding PaceText}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#9CA3AF"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding PaceText, Converter={StaticResource HasValue}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="This provider reported no quota window."
                           Margin="0,2,0,6"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           Visibility="{Binding Windows, Converter={StaticResource Empty}}" />

                <StackPanel Margin="0,2,0,0">
                    <Border Height="1" Background="#0F000000" Margin="0,2,0,6" />

                    <Button Style="{StaticResource ActionButton}"
                            Click="OnConfigureProvider"
                            Tag="{Binding Key}"
                            ToolTip="Open setup for this provider">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE77B;" />
                            <TextBlock Text="{Binding SetupLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}"
                            Click="OnOpenDashboard"
                            ToolTip="{Binding Links.DashboardUrl}"
                            Visibility="{Binding Links.HasDashboard, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE774;" />
                            <TextBlock Text="Usage Dashboard" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}"
                            Click="OnOpenStatusPage"
                            ToolTip="{Binding Links.StatusUrl}"
                            Visibility="{Binding Links.HasStatusPage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE7BA;" />
                            <TextBlock Text="Status Page" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12"
            Background="#FCFCFD"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Provider switcher: one pill per enabled provider. -->
            <Border Grid.Row="0" Padding="10,10,10,8" Visibility="{Binding HasProviders, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ProviderCount}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TabButton}"
                                    Tag="{Binding Key}"
                                    Click="OnSelectProvider"
                                    ToolTip="{Binding Status}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border CornerRadius="11"
                                            Background="{Binding Accent, Converter={StaticResource HexBrush}}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="8,7,8,6">
                                        <Path Data="{Binding IconPath, Converter={StaticResource IconGeometry}}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              StrokeThickness="1.3"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,5,0,0"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Ellipse Width="5"
                                                 Height="5"
                                                 Margin="0,4,0,0"
                                                 HorizontalAlignment="Center"
                                                 Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="1"
                    Height="1"
                    Background="#0F000000"
                    Visibility="{Binding HasProviders, Converter={StaticResource BoolToVisibility}}" />

            <!-- Detail of the selected provider; long quotas scroll, the menus stay put. -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="430"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <Grid>
                    <ContentControl Content="{Binding Selected}"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding Selected, Converter={StaticResource HasValue}}"
                                    ContentTemplate="{StaticResource ProviderDetail}" />
                    <StackPanel Margin="16,24,16,16"
                                Visibility="{Binding Selected, Converter={StaticResource Empty}}">
                        <TextBlock Text="No providers enabled"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Open Settings and choose at least one provider."
                                   Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="10,0,10,8">
                <Border Height="1" Background="#0F000000" Margin="6,0,6,6" />

                <Button Style="{StaticResource ActionButton}" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE713;" />
                        <TextBlock Text="Settings…" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="OnAbout">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE946;" />
                        <TextBlock Text="About CodexBar" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="OnQuit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE7E8;" />
                        <TextBlock Text="Quit" />
                    </StackPanel>
                </Button>

                <DockPanel LastChildFill="False" Margin="4,4,4,0">
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Style="{StaticResource LinkButton}"
                            Click="OnRefresh"
                            ToolTip="Fetch every provider now" />
                    <Button Content="Copy diagnostics"
                            Style="{StaticResource LinkButton}"
                            Click="OnCopyDiagnostics"
                            ToolTip="Copy a redacted diagnostics bundle" />
                    <TextBlock x:Name="DiagnosticsStatus"
                               Margin="6,0,0,0"
                               MaxWidth="180"
                               FontSize="11"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
