<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette for the flyout. Keys are shared with Theme.Light.xaml. -->
    <SolidColorBrush x:Key="Flyout.Surface" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Flyout.Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Flyout.Text" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Flyout.TextSecondary" Color="#C9C9C9" />
    <SolidColorBrush x:Key="Flyout.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Flyout.Divider" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Flyout.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Flyout.Pressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Flyout.TabInactive" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Flyout.PlanBg" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Flyout.PlanFg" Color="#C9C9C9" />
    <SolidColorBrush x:Key="Flyout.Track" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Flyout.ExhaustedBg" Color="#33F87171" />
    <SolidColorBrush x:Key="Flyout.ExhaustedFg" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Flyout.DisabledBg" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Flyout.DisabledFg" Color="#E5C07B" />
    <SolidColorBrush x:Key="Flyout.StatusWarn" Color="#FBBF24" />
    <SolidColorBrush x:Key="Flyout.ScrollThumb" Color="#33FFFFFF" />
</ResourceDictionary>
