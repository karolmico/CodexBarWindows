<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette for the flyout. Keys are shared with Theme.Dark.xaml. -->
    <SolidColorBrush x:Key="Flyout.Surface" Color="#FCFCFD" />
    <SolidColorBrush x:Key="Flyout.Border" Color="#1A000000" />
    <SolidColorBrush x:Key="Flyout.Text" Color="#111827" />
    <SolidColorBrush x:Key="Flyout.TextSecondary" Color="#4B5563" />
    <SolidColorBrush x:Key="Flyout.TextTertiary" Color="#9CA3AF" />
    <SolidColorBrush x:Key="Flyout.Divider" Color="#0F000000" />
    <SolidColorBrush x:Key="Flyout.Hover" Color="#0A000000" />
    <SolidColorBrush x:Key="Flyout.Pressed" Color="#14000000" />
    <SolidColorBrush x:Key="Flyout.TabInactive" Color="#7A7A85" />
    <SolidColorBrush x:Key="Flyout.PlanBg" Color="#0C000000" />
    <SolidColorBrush x:Key="Flyout.PlanFg" Color="#4B5563" />
    <SolidColorBrush x:Key="Flyout.Track" Color="#14000000" />
    <SolidColorBrush x:Key="Flyout.ExhaustedBg" Color="#14B42318" />
    <SolidColorBrush x:Key="Flyout.ExhaustedFg" Color="#B42318" />
    <SolidColorBrush x:Key="Flyout.DisabledBg" Color="#10B45309" />
    <SolidColorBrush x:Key="Flyout.DisabledFg" Color="#92620B" />
    <SolidColorBrush x:Key="Flyout.StatusWarn" Color="#B45309" />
    <SolidColorBrush x:Key="Flyout.ScrollThumb" Color="#26000000" />
</ResourceDictionary>
